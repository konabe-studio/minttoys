#: minttoys/cli.py
msgid "MintToys needs PyGObject: sudo apt install python3-gi"
msgstr ""
"A MintToys működéséhez PyGObject szükséges: sudo apt install python3-gi"

#: minttoys/cli.py
msgid "MintToys is not running in this session."
msgstr "A MintToys nem fut ebben a munkamenetben."

#: minttoys/cli.py minttoys/tray/app.py
msgid "Awake is switched off in MintToys."
msgstr "Az Awake ki van kapcsolva a MintToysban."

#: minttoys/cli.py
msgid "Switch it on with: minttoys modules enable awake"
msgstr "Így kapcsolhatja be: minttoys modules enable awake"

#: minttoys/cli.py minttoys/settings/awake_page.py
#: minttoys/settings/overview_page.py minttoys/tray/app.py
#, python-brace-format
msgid "MintToys refused: {reason}"
msgstr "A MintToys nem teljesítette a kérést: {reason}"

#. TRANSLATORS: a module's state in the list `minttoys modules` prints.
#: minttoys/cli.py
msgid "on"
msgstr "bekapcsolva"

#. TRANSLATORS: a module's state in the list `minttoys modules` prints.
#: minttoys/cli.py
msgid "off"
msgstr "kikapcsolva"

#. TRANSLATORS: a module's state in the list `minttoys modules` prints.
#: minttoys/cli.py
msgid "failed"
msgstr "hibás"

#: minttoys/cli.py
msgid "Power-user utilities for Linux Mint Cinnamon."
msgstr "Segédeszközök haladó felhasználóknak, Linux Mint Cinnamonhoz."

#: minttoys/cli.py
msgid "COMMAND"
msgstr "PARANCS"

#: minttoys/cli.py
msgid "keep the computer awake"
msgstr "a számítógép ébren tartása"

#: minttoys/cli.py
msgid "Keep the computer awake."
msgstr "A számítógép ébren tartása."

#: minttoys/cli.py
msgid "ACTION"
msgstr "MŰVELET"

#: minttoys/cli.py
msgid "switch Awake on"
msgstr "az Awake bekapcsolása"

#: minttoys/cli.py
msgid ""
"Switch Awake on: until you turn it off, for a set time, or until a time of "
"day."
msgstr ""
"Az Awake bekapcsolása: amíg ki nem kapcsolja, adott ideig vagy egy adott "
"időpontig."

#: minttoys/cli.py
msgid "DURATION"
msgstr "IDŐTARTAM"

#: minttoys/cli.py
msgid "stay awake this long: 90 or 90m, 2h, 1h30m"
msgstr "ébren tartás ennyi ideig: 90 vagy 90m, 2h, 1h30m"

#: minttoys/cli.py
msgid "HH:MM"
msgstr "ÓÓ:PP"

#: minttoys/cli.py
msgid "stay awake until this time of day, even one past midnight"
msgstr "ébren tartás eddig az időpontig, akár éjfél után is"

#: minttoys/cli.py
msgid "keep the screen on as well, or not; without either, as set in MintToys"
msgstr ""
"a képernyő is maradjon bekapcsolva, vagy ne; ha egyik sincs megadva, a "
"MintToys beállítása szerint"

#: minttoys/cli.py
msgid "switch Awake off"
msgstr "az Awake kikapcsolása"

#: minttoys/cli.py
msgid "switch Awake off when on, or on as set in MintToys; good for a shortcut"
msgstr ""
"az Awake kikapcsolása, ha be van kapcsolva, különben bekapcsolása a MintToys "
"beállítása szerint; gyorsbillentyűhöz ideális"

#: minttoys/cli.py
msgid "show whether Awake is on, and for how long"
msgstr "megmutatja, be van-e kapcsolva az Awake, és meddig"

#: minttoys/cli.py
msgid "list the modules, switch one on or off"
msgstr "a modulok listázása, egy modul be- vagy kikapcsolása"

#: minttoys/cli.py
msgid "List MintToys' modules, or switch one on or off."
msgstr ""
"A MintToys moduljainak listázása, vagy egy modul be- vagy kikapcsolása."

#: minttoys/cli.py
msgid "list the modules and their state (the default)"
msgstr "a modulok és állapotuk listázása (alapértelmezés)"

#: minttoys/cli.py
msgid "switch a module on"
msgstr "egy modul bekapcsolása"

#: minttoys/cli.py
msgid "switch a module off"
msgstr "egy modul kikapcsolása"

#: minttoys/cli.py
msgid "MODULE"
msgstr "MODUL"

#: minttoys/cli.py
#, python-brace-format
msgid ""
"'{text}' is not a duration. Use minutes (90 or 90m), hours (2h), or both "
"(1h30m)."
msgstr ""
"„{text}” nem időtartam. Adja meg percben (90 vagy 90m), órában (2h) vagy "
"órában és percben (1h30m)."

#: minttoys/cli.py
#, python-brace-format
msgid "'{text}' is not a time of day. Use hours and minutes, such as 18:00."
msgstr "„{text}” nem időpont. Adja meg óra:perc alakban, például 18:00."

#: minttoys/modules/awake/module.py minttoys/settings/awake_page.py
msgid "Awake"
msgstr "Awake"

#: minttoys/modules/awake/module.py
msgid ""
"Keeps the computer awake until you turn it off, for a set time, or until a "
"time of day, without changing your power settings."
msgstr ""
"Ébren tartja a számítógépet, amíg ki nem kapcsolja, adott ideig vagy egy "
"adott időpontig, az energiagazdálkodási beállítások módosítása nélkül."

#: minttoys/modules/awake/module.py
msgid "Awake is keeping the computer awake"
msgstr "Az Awake ébren tartja a számítógépet"

#: minttoys/modules/awake/module.py
msgid "Awake is off"
msgstr "Az Awake kikapcsolt"

#: minttoys/modules/awake/module.py
msgid "The time is up. Your usual power settings apply again."
msgstr ""
"Letelt az idő. Ismét a megszokott energiagazdálkodási beállítások érvényesek."

#: minttoys/modules/awake/text.py
msgid "Awake is off."
msgstr "Az Awake ki van kapcsolva."

#: minttoys/modules/awake/text.py
msgid "Awake is on until you turn it off."
msgstr "Az Awake bekapcsolva marad, amíg ki nem kapcsolja."

#. TRANSLATORS: {left} is the time left, such as "1 h 25 min", and {end} the time Awake
#. ends, such as "18:00", with the date in front when that is more than a day away.
#: minttoys/modules/awake/text.py
#, python-brace-format
msgid "Awake is on for {left} more, until {end}."
msgstr "Az Awake {end}-ig marad bekapcsolva, még {left} van hátra."

#: minttoys/modules/awake/text.py
msgid "The screen stays on."
msgstr "A képernyő bekapcsolva marad."

#: minttoys/modules/awake/text.py
msgid "The screen may turn off, but the computer will not sleep."
msgstr "A képernyő kikapcsolhat, de a számítógép nem megy alvó állapotba."

#: minttoys/modules/awake/text.py
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} perc"

#: minttoys/modules/awake/text.py
#, python-brace-format
msgid "{hours} h"
msgstr "{hours} óra"

#: minttoys/modules/awake/text.py
#, python-brace-format
msgid "{hours} h {minutes} min"
msgstr "{hours} óra {minutes} perc"

#. TRANSLATORS: the units after the hours field and after the minutes field.
#: minttoys/settings/awake_page.py minttoys/tray/app.py
msgid "h"
msgstr "óra"

#. TRANSLATORS: the units after the hours field and after the minutes field.
#: minttoys/settings/awake_page.py minttoys/tray/app.py
msgid "min"
msgstr "perc"

#: minttoys/settings/awake_page.py
msgid "Keeps the computer awake, without changing your power settings."
msgstr ""
"Ébren tartja a számítógépet, az energiagazdálkodási beállítások módosítása "
"nélkül."

#: minttoys/settings/awake_page.py
msgid "Use Awake"
msgstr "Awake használata"

#: minttoys/settings/awake_page.py
msgid "When you click the panel icon"
msgstr "A panelikonra kattintáskor"

#: minttoys/settings/awake_page.py
msgid ""
"The same goes for minttoys awake toggle, on a keyboard shortcut or in a "
"script."
msgstr ""
"Ugyanez érvényes a minttoys awake toggle parancsra is, gyorsbillentyűn vagy "
"szkriptben."

#: minttoys/settings/awake_page.py
msgid "Keep the computer awake"
msgstr "Számítógép ébren tartása"

#. TRANSLATORS: the label in front of the hours and minutes of a duration.
#: minttoys/settings/awake_page.py
msgid "For"
msgstr "Időtartam"

#. TRANSLATORS: the label in front of a time of day.
#: minttoys/settings/awake_page.py
msgid "Until"
msgstr "Időpont"

#: minttoys/settings/awake_page.py minttoys/tray/app.py
msgid "Keep the screen on"
msgstr "Képernyő bekapcsolva tartása"

#: minttoys/settings/awake_page.py
msgid "Otherwise the screen may turn off, but the computer will not sleep."
msgstr ""
"Különben a képernyő kikapcsolhat, de a számítógép nem megy alvó állapotba."

#: minttoys/settings/awake_page.py
msgid "Keyboard shortcut"
msgstr "Gyorsbillentyű"

#: minttoys/settings/awake_page.py
msgid "Add a custom shortcut in the Keyboard settings with this command."
msgstr ""
"Ezzel a paranccsal vegyen fel egyéni gyorsbillentyűt a "
"billentyűzet-beállításokban."

#: minttoys/settings/awake_page.py
msgid "Command"
msgstr "Parancs"

#: minttoys/settings/awake_page.py
msgid "Open the Keyboard settings"
msgstr "Billentyűzet-beállítások megnyitása"

#: minttoys/settings/awake_page.py
msgid "This version of MintToys has no Awake."
msgstr "A MintToys ezen verziójában nincs Awake."

#: minttoys/settings/awake_page.py minttoys/tray/app.py
msgid "MintToys is not running."
msgstr "A MintToys nem fut."

#: minttoys/settings/awake_page.py
#, python-brace-format
msgid "Could not read Awake's settings: {error}"
msgstr "Az Awake beállításai nem olvashatók be: {error}"

#: minttoys/settings/awake_page.py
#, python-brace-format
msgid "Awake could not be switched on: {error}"
msgstr "Az Awake bekapcsolása nem sikerült: {error}"

#. TRANSLATORS: a heading in the settings window's sidebar, over the tools that
#. deal with the computer as a whole, such as Awake.
#: minttoys/settings/catalog.py
msgid "System"
msgstr "Rendszer"

#: minttoys/settings/main.py
#, python-brace-format
msgid "The settings need PyGObject, GTK 3 and python3-xapp: {error}"
msgstr "A beállításokhoz PyGObject, GTK 3 és python3-xapp szükséges: {error}"

#: minttoys/settings/main.py minttoys/settings/window.py
#: data/applications/io.github.konabe_studio.MintToys.desktop.in
#: data/autostart/io.github.konabe_studio.MintToys.desktop.in
msgid "MintToys"
msgstr "MintToys"

#. TRANSLATORS: under a tool's description in the Overview, when it failed.
#: minttoys/settings/overview_page.py
#, python-brace-format
msgid "Could not be switched on: {error}"
msgstr "Nem sikerült bekapcsolni: {error}"

#: minttoys/settings/overview_page.py
msgid ""
"Welcome to MintToys. Switch on the tools you want to use. Each one has a "
"page of its own in the sidebar."
msgstr ""
"Üdvözli a MintToys. Kapcsolja be azokat az eszközöket, amelyeket használni "
"szeretne. Mindegyiknek saját oldala van az oldalsávon."

#: minttoys/settings/overview_page.py
msgid "Tools"
msgstr "Eszközök"

#: minttoys/settings/values.py minttoys/tray/app.py
msgid "Until turned off"
msgstr "Kikapcsolásig"

#: minttoys/settings/values.py
msgid "For a set time"
msgstr "Adott ideig"

#: minttoys/settings/values.py
msgid "Until a time of day"
msgstr "Egy adott időpontig"

#. TRANSLATORS: the first page of the settings window, listing every tool.
#: minttoys/settings/window.py
msgid "Overview"
msgstr "Áttekintés"

#: minttoys/tray/app.py
msgid "For a custom time…"
msgstr "Egyéni időtartamra…"

#: minttoys/tray/app.py
msgid "Until a time of day…"
msgstr "Egy adott időpontig…"

#: minttoys/tray/app.py
msgid "Turn off"
msgstr "Kikapcsolás"

#: minttoys/tray/app.py
msgid "Settings…"
msgstr "Beállítások…"

#: minttoys/tray/app.py
msgid "Keep the computer awake for"
msgstr "Számítógép ébren tartása ennyi ideig"

#: minttoys/tray/app.py
msgid "Keep the computer awake until"
msgstr "Számítógép ébren tartása eddig"

#: minttoys/tray/app.py
msgid "Cancel"
msgstr "Mégse"

#: minttoys/tray/app.py
msgid "Start"
msgstr "Indítás"

#: minttoys/tray/main.py
#, python-brace-format
msgid "The panel icon needs PyGObject, GTK 3 and XApp: {error}"
msgstr "A panelikonhoz PyGObject, GTK 3 és XApp szükséges: {error}"

#: minttoys/tray/main.py
msgid "The panel icon needs a desktop session."
msgstr "A panelikonhoz asztali munkamenet szükséges."

#: minttoys/tray/main.py
msgid "The MintToys panel icon is already running."
msgstr "A MintToys panelikonja már fut."

#. TRANSLATORS: items of the panel icon's menu, each keeping the computer awake for
#. that long.
#: minttoys/tray/view.py
#, python-brace-format
msgid "For {count} minute"
msgid_plural "For {count} minutes"
msgstr[0] "{count} percre"
msgstr[1] "{count} percre"

#: minttoys/tray/view.py
#, python-brace-format
msgid "For {count} hour"
msgid_plural "For {count} hours"
msgstr[0] "{count} órára"
msgstr[1] "{count} órára"

#: data/applications/io.github.konabe_studio.MintToys.desktop.in
msgid "Power-user utilities"
msgstr "Segédeszközök haladó felhasználóknak"

#: data/applications/io.github.konabe_studio.MintToys.desktop.in
msgid "Switch MintToys' tools on and off, and set them up"
msgstr "A MintToys eszközeinek be- és kikapcsolása, beállítása"

#: data/applications/io.github.konabe_studio.MintToys.desktop.in
msgid "Awake;Sleep;Suspend;Screen;"
msgstr ""
"Awake;Ébren;Alvás;Felfüggesztés;Képernyő;Energiagazdálkodás;Sleep;Suspend;Screen;"

#: data/autostart/io.github.konabe_studio.MintToys.Tray.desktop.in
msgid "MintToys panel icon"
msgstr "MintToys panelikon"

#: data/autostart/io.github.konabe_studio.MintToys.Tray.desktop.in
msgid "Keep the computer awake from the panel"
msgstr "A számítógép ébren tartása a panelről"

#: data/autostart/io.github.konabe_studio.MintToys.desktop.in
msgid "The background service behind MintToys' tools"
msgstr "A MintToys eszközeit működtető háttérszolgáltatás"

#: minttoys/cli.py
msgid "switch between light and dark"
msgstr "váltás a világos és a sötét között"

#: minttoys/cli.py
msgid "Switch the desktop between light and dark, or show when it is dark."
msgstr ""
"Az asztal váltása a világos és a sötét között, vagy a sötét órák "
"megjelenítése."

#: minttoys/cli.py
msgid "show the mode and the dark hours (the default)"
msgstr "a mód és a sötét órák megjelenítése (alapértelmezés)"

#: minttoys/cli.py
msgid "switch to dark, or back to the day's mode, until the schedule changes"
msgstr ""
"váltás sötétre, vagy vissza a nappali módra, az ütemezés következő váltásáig"

#: minttoys/cli.py
msgid "Light Switch is switched off in MintToys."
msgstr "A Light Switch ki van kapcsolva a MintToysban."

#: minttoys/cli.py
msgid "Switch it on with: minttoys modules enable lightswitch"
msgstr "Így kapcsolhatja be: minttoys modules enable lightswitch"

#: minttoys/modules/lightswitch/module.py minttoys/settings/lightswitch_page.py
msgid "Light Switch"
msgstr "Light Switch"

#: minttoys/modules/lightswitch/module.py
msgid ""
"Switches between light and dark by the time of day, the way the Themes "
"window does."
msgstr ""
"Napszak szerint vált a világos és a sötét között, ahogy a Témák ablak is."

#. TRANSLATORS: Light Switch's dark hours by the sun; {start} and {end} are times of
#. day such as 18:09 and 06:53.
#: minttoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Dark from {start} to {end}, sunset to sunrise."
msgstr "Sötét {start} és {end} között, napnyugtától napkeltéig."

#. TRANSLATORS: Light Switch's dark hours at set times, such as 20:00 and 06:00.
#: minttoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Dark from {start} to {end}."
msgstr "Sötét {start} és {end} között."

#: minttoys/modules/lightswitch/text.py
msgid ""
"Your themes are not one of Mint's styles, so Light Switch leaves them alone."
msgstr ""
"A témái nem tartoznak a Mint stílusai közé, ezért a Light Switch nem "
"változtat rajtuk."

#: minttoys/modules/lightswitch/text.py
msgid "Your style has no mode to switch to."
msgstr "A stílusának nincs olyan módja, amelyre váltani lehetne."

#: minttoys/modules/lightswitch/text.py
msgid "The desktop is dark now."
msgstr "Az asztal most sötét."

#: minttoys/modules/lightswitch/text.py
msgid "The desktop is in its day mode now."
msgstr "Az asztal most nappali módban van."

#: minttoys/settings/lightswitch_page.py
msgid "Switches between light and dark by the time of day, keeping your color."
msgstr "Napszak szerint vált a világos és a sötét között, a színt megtartva."

#: minttoys/settings/lightswitch_page.py
msgid "Use Light Switch"
msgstr "Light Switch használata"

#: minttoys/settings/lightswitch_page.py
msgid "Light and dark"
msgstr "Világos és sötét"

#. TRANSLATORS: the label of the choice between the Themes window's Mixed and Light.
#: minttoys/settings/lightswitch_page.py
msgid "During the day"
msgstr "Nappal"

#: minttoys/settings/lightswitch_page.py
msgid "Dark"
msgstr "Sötét"

#. TRANSLATORS: the labels in front of the times dark starts and ends.
#: minttoys/settings/lightswitch_page.py
msgid "From"
msgstr "Kezdete"

#. TRANSLATORS: the labels in front of the times dark starts and ends.
#: minttoys/settings/lightswitch_page.py
msgid "To"
msgstr "Vége"

#: minttoys/settings/lightswitch_page.py
msgid "Open the Night Light settings"
msgstr "Az Éjszakai fény beállításainak megnyitása"

#: minttoys/settings/lightswitch_page.py
msgid "Right now"
msgstr "Most"

#: minttoys/settings/lightswitch_page.py
msgid "Switch now"
msgstr "Váltás most"

#: minttoys/settings/lightswitch_page.py
msgid "This version of MintToys has no Light Switch."
msgstr "A MintToys ezen verziójában nincs Light Switch."

#: minttoys/settings/lightswitch_page.py
#, python-brace-format
msgid "Light Switch could not be switched on: {error}"
msgstr "A Light Switch bekapcsolása nem sikerült: {error}"

#: minttoys/settings/lightswitch_page.py
#, python-brace-format
msgid "Could not read Light Switch's settings: {error}"
msgstr "A Light Switch beállításai nem olvashatók be: {error}"

#. TRANSLATORS: the Themes window's mode with light windows and a dark panel.
#: minttoys/settings/values.py
msgid "Mixed"
msgstr "Vegyes"

#. TRANSLATORS: the Themes window's mode with light windows and a light panel.
#: minttoys/settings/values.py
msgid "Light"
msgstr "Világos"

#: minttoys/settings/values.py
msgid "With Night Light's schedule"
msgstr "Az Éjszakai fény ütemezése szerint"

#: minttoys/settings/values.py
msgid "At set times"
msgstr "Megadott időpontokban"

#. TRANSLATORS: {keys} is a keyboard shortcut such as Shift+Ctrl+Super+D.
#: minttoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Keyboard shortcut: {keys}"
msgstr "Gyorsbillentyű: {keys}"

#: minttoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Its keyboard shortcut, {keys}, is in use already, so it has none."
msgstr "Nincs gyorsbillentyűje, mert a kombináció ({keys}) már foglalt."

#: minttoys/settings/lightswitch_page.py
msgid "Change its keys in the Keyboard settings, under MintToys: Light Switch."
msgstr ""
"A billentyűkombinációt a billentyűzet-beállításokban módosíthatja, "
"„MintToys: Light Switch” néven."

#: minttoys/settings/lightswitch_page.py
msgid "Switch now with a keyboard shortcut"
msgstr "Váltás gyorsbillentyűvel"

#: minttoys/modules/locksmith/module.py minttoys/locksmith/main.py minttoys/settings/window.py minttoys/locksmith/window.py
msgid "File Locksmith"
msgstr "File Locksmith"

#: minttoys/locksmith/main.py
msgid "Usage: minttoys-locksmith FILE..."
msgstr "Használat: minttoys-locksmith FÁJL..."

#: minttoys/locksmith/main.py
#, python-brace-format
msgid "File Locksmith needs PyGObject and GTK 3: {error}"
msgstr "A File Locksmith működéséhez PyGObject és GTK 3 kell: {error}"

#: minttoys/locksmith/window.py
msgid "Force it to stop? Unsaved work in it will be lost."
msgstr "Kényszeríti a leállítását? A benne lévő, nem mentett munka elvész."

#: minttoys/locksmith/window.py
msgid "Force stop"
msgstr "Kényszerített leállítás"

#: minttoys/locksmith/window.py
msgid "Process"
msgstr "Folyamat"

#: minttoys/locksmith/window.py
msgid "PID"
msgstr "PID"

#. TRANSLATORS: the column of what a process holds of the chosen files.
#: minttoys/locksmith/window.py
msgid "Holds"
msgstr "Használja"

#: minttoys/locksmith/window.py
msgid "Refresh"
msgstr "Frissítés"

#: minttoys/locksmith/window.py
msgid "End process"
msgstr "Folyamat leállítása"

#: minttoys/locksmith/window.py
#, python-brace-format
msgid "{name} did not stop."
msgstr "{name} nem állt le."

#: minttoys/locksmith/window.py
#, python-brace-format
msgid "You may not end {name}."
msgstr "Ezt a folyamatot nem állíthatja le: {name}."

#. TRANSLATORS: File Locksmith's item in Nemo's right-click menu.
#: minttoys/modules/locksmith/module.py
msgid "What is using this?"
msgstr "Mi használja ezt?"

#. TRANSLATORS: the tooltip of File Locksmith's item in Nemo's right-click menu.
#: minttoys/modules/locksmith/module.py
msgid "Shows the processes that hold it open, and lets you end them."
msgstr "Megmutatja, mely folyamatok tartják nyitva, és leállíthatja őket."

#: minttoys/modules/locksmith/module.py
msgid ""
"Shows which processes hold a file or a folder, from Nemo's right-click menu."
msgstr ""
"Megmutatja, mely folyamatok használnak egy fájlt vagy mappát, a Nemo jobb "
"gombos menüjéből."

#: minttoys/modules/locksmith/text.py
msgid "Nothing of yours is using it right now."
