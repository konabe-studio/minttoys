msgstr[1] "{count} órára"

#: data/applications/io.github.konabe_studio.TuxToys.desktop.in
msgid "Power-user utilities"
msgstr "Segédeszközök haladó felhasználóknak"

#: data/applications/io.github.konabe_studio.TuxToys.desktop.in
msgid "Switch TuxToys' tools on and off, and set them up"
msgstr "A TuxToys eszközeinek be- és kikapcsolása, beállítása"

#: data/applications/io.github.konabe_studio.TuxToys.desktop.in
msgid "Awake;Sleep;Suspend;Screen;"
msgstr ""
"Awake;Ébren;Alvás;Felfüggesztés;Képernyő;Energiagazdálkodás;Sleep;Suspend;Screen;"

#: data/autostart/io.github.konabe_studio.TuxToys.Tray.desktop.in
msgid "TuxToys panel icon"
msgstr "TuxToys panelikon"

#: data/autostart/io.github.konabe_studio.TuxToys.Tray.desktop.in
msgid "Keep the computer awake from the panel"
msgstr "A számítógép ébren tartása a panelről"

#: data/autostart/io.github.konabe_studio.TuxToys.desktop.in
msgid "The background service behind TuxToys' tools"
msgstr "A TuxToys eszközeit működtető háttérszolgáltatás"

#: tuxtoys/cli.py
msgid "switch between light and dark"
msgstr "váltás a világos és a sötét között"

#: tuxtoys/cli.py
msgid "Switch the desktop between light and dark, or show when it is dark."
msgstr ""
"Az asztal váltása a világos és a sötét között, vagy a sötét órák "
"megjelenítése."

#: tuxtoys/cli.py
msgid "show the mode and the dark hours (the default)"
msgstr "a mód és a sötét órák megjelenítése (alapértelmezés)"

#: tuxtoys/cli.py
msgid "switch to dark, or back to the day's mode, until the schedule changes"
msgstr ""
"váltás sötétre, vagy vissza a nappali módra, az ütemezés következő váltásáig"

#: tuxtoys/cli.py
msgid "Light Switch is switched off in TuxToys."
msgstr "A Light Switch ki van kapcsolva a TuxToysban."

#: tuxtoys/cli.py
msgid "Switch it on with: tuxtoys modules enable lightswitch"
msgstr "Így kapcsolhatja be: tuxtoys modules enable lightswitch"

#: tuxtoys/modules/lightswitch/module.py tuxtoys/settings/lightswitch_page.py
msgid "Light Switch"
msgstr "Light Switch"

#: tuxtoys/modules/lightswitch/module.py
msgid ""
"Switches between light and dark by the time of day, the way the Themes "
"window does."
msgstr ""
"Napszak szerint vált a világos és a sötét között, ahogy a Témák ablak is."

#. TRANSLATORS: Light Switch's dark hours by the sun; {start} and {end} are times of
#. day such as 18:09 and 06:53.
#: tuxtoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Dark from {start} to {end}, sunset to sunrise."
msgstr "Sötét {start} és {end} között, napnyugtától napkeltéig."

#. TRANSLATORS: Light Switch's dark hours at set times, such as 20:00 and 06:00.
#: tuxtoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Dark from {start} to {end}."
msgstr "Sötét {start} és {end} között."

#: tuxtoys/modules/lightswitch/text.py
msgid ""
"Your themes are not one of Mint's styles, so Light Switch leaves them alone."
msgstr ""
"A témái nem tartoznak a Mint stílusai közé, ezért a Light Switch nem "
"változtat rajtuk."

#: tuxtoys/modules/lightswitch/text.py
msgid "Your style has no mode to switch to."
msgstr "A stílusának nincs olyan módja, amelyre váltani lehetne."

#: tuxtoys/modules/lightswitch/text.py
msgid "The desktop is dark now."
msgstr "Az asztal most sötét."

#: tuxtoys/modules/lightswitch/text.py
msgid "The desktop is in its day mode now."
msgstr "Az asztal most nappali módban van."

#: tuxtoys/settings/lightswitch_page.py
msgid "Switches between light and dark by the time of day, keeping your color."
msgstr "Napszak szerint vált a világos és a sötét között, a színt megtartva."

#: tuxtoys/settings/lightswitch_page.py
msgid "Use Light Switch"
msgstr "Light Switch használata"

#: tuxtoys/settings/lightswitch_page.py
msgid "Light and dark"
msgstr "Világos és sötét"

#. TRANSLATORS: the label of the choice between the Themes window's Mixed and Light.
#: tuxtoys/settings/lightswitch_page.py
msgid "During the day"
msgstr "Nappal"

#: tuxtoys/settings/lightswitch_page.py
msgid "Dark"
msgstr "Sötét"

#. TRANSLATORS: the labels in front of the times dark starts and ends.
#: tuxtoys/settings/lightswitch_page.py
msgid "From"
msgstr "Kezdete"

#. TRANSLATORS: the labels in front of the times dark starts and ends.
#: tuxtoys/settings/lightswitch_page.py
msgid "To"
msgstr "Vége"

#: tuxtoys/settings/lightswitch_page.py
msgid "Open the Night Light settings"
msgstr "Az Éjszakai fény beállításainak megnyitása"

#: tuxtoys/settings/lightswitch_page.py
msgid "Right now"
msgstr "Most"

#: tuxtoys/settings/lightswitch_page.py
msgid "Switch now"
msgstr "Váltás most"

#: tuxtoys/settings/lightswitch_page.py
msgid "This version of TuxToys has no Light Switch."
msgstr "A TuxToys ezen verziójában nincs Light Switch."

#: tuxtoys/settings/lightswitch_page.py
#, python-brace-format
msgid "Light Switch could not be switched on: {error}"
msgstr "A Light Switch bekapcsolása nem sikerült: {error}"

#: tuxtoys/settings/lightswitch_page.py
#, python-brace-format
msgid "Could not read Light Switch's settings: {error}"
msgstr "A Light Switch beállításai nem olvashatók be: {error}"

#. TRANSLATORS: the Themes window's mode with light windows and a dark panel.
#: tuxtoys/settings/values.py
msgid "Mixed"
msgstr "Vegyes"

#. TRANSLATORS: the Themes window's mode with light windows and a light panel.
#: tuxtoys/settings/values.py
msgid "Light"
msgstr "Világos"

#: tuxtoys/settings/values.py
msgid "With Night Light's schedule"
msgstr "Az Éjszakai fény ütemezése szerint"

#: tuxtoys/settings/values.py
msgid "At set times"
msgstr "Megadott időpontokban"

#. TRANSLATORS: {keys} is a keyboard shortcut such as Shift+Ctrl+Super+D.
#: tuxtoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Keyboard shortcut: {keys}"
msgstr "Gyorsbillentyű: {keys}"

#: tuxtoys/modules/lightswitch/text.py
#, python-brace-format
msgid "Its keyboard shortcut, {keys}, is in use already, so it has none."
msgstr "Nincs gyorsbillentyűje, mert a kombináció ({keys}) már foglalt."

#: tuxtoys/settings/lightswitch_page.py
msgid "Change its keys in the Keyboard settings, under TuxToys: Light Switch."
msgstr ""
"A billentyűkombinációt a billentyűzet-beállításokban módosíthatja, "
"„TuxToys: Light Switch” néven."

#: tuxtoys/settings/lightswitch_page.py
msgid "Switch now with a keyboard shortcut"
msgstr "Váltás gyorsbillentyűvel"

#: tuxtoys/modules/locksmith/module.py tuxtoys/locksmith/main.py tuxtoys/settings/window.py tuxtoys/locksmith/window.py
msgid "File Locksmith"
msgstr "File Locksmith"

#: tuxtoys/locksmith/main.py
msgid "Usage: tuxtoys-locksmith FILE..."
msgstr "Használat: tuxtoys-locksmith FÁJL..."

#: tuxtoys/locksmith/main.py
#, python-brace-format
msgid "File Locksmith needs PyGObject and GTK 3: {error}"
msgstr "A File Locksmith működéséhez PyGObject és GTK 3 kell: {error}"

#: tuxtoys/locksmith/window.py
msgid "Force it to stop? Unsaved work in it will be lost."
msgstr "Kényszeríti a leállítását? A benne lévő, nem mentett munka elvész."

#: tuxtoys/locksmith/window.py
msgid "Force stop"
msgstr "Kényszerített leállítás"

#: tuxtoys/locksmith/window.py
msgid "Process"
msgstr "Folyamat"

#: tuxtoys/locksmith/window.py
msgid "PID"
msgstr "PID"

#. TRANSLATORS: the column of what a process holds of the chosen files.
#: tuxtoys/locksmith/window.py
msgid "Holds"
msgstr "Használja"

#: tuxtoys/locksmith/window.py
msgid "Refresh"
msgstr "Frissítés"

#: tuxtoys/locksmith/window.py
msgid "End process"
msgstr "Folyamat leállítása"

#: tuxtoys/locksmith/window.py
#, python-brace-format
msgid "{name} did not stop."
msgstr "{name} nem állt le."

#: tuxtoys/locksmith/window.py
#, python-brace-format
msgid "You may not end {name}."
msgstr "Ezt a folyamatot nem állíthatja le: {name}."

#. TRANSLATORS: File Locksmith's item in Nemo's right-click menu.
#: tuxtoys/modules/locksmith/module.py
msgid "What is using this?"
msgstr "Mi használja ezt?"

#. TRANSLATORS: the tooltip of File Locksmith's item in Nemo's right-click menu.
#: tuxtoys/modules/locksmith/module.py
msgid "Shows the processes that hold it open, and lets you end them."
msgstr "Megmutatja, mely folyamatok tartják nyitva, és leállíthatja őket."

#: tuxtoys/modules/locksmith/module.py
msgid ""
"Shows which processes hold a file or a folder, from Nemo's right-click menu."
msgstr ""
"Megmutatja, mely folyamatok használnak egy fájlt vagy mappát, a Nemo jobb "
