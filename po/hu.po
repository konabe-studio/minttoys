#: tuxtoys/cli.py
msgid "TuxToys needs PyGObject: sudo apt install python3-gi"
msgstr ""
"A TuxToys működéséhez PyGObject szükséges: sudo apt install python3-gi"

#: tuxtoys/cli.py
msgid "TuxToys is not running in this session."
msgstr "A TuxToys nem fut ebben a munkamenetben."

#: tuxtoys/cli.py tuxtoys/tray/app.py
msgid "Awake is switched off in TuxToys."
msgstr "Az Awake ki van kapcsolva a TuxToysban."

#: tuxtoys/cli.py
msgid "Switch it on with: tuxtoys modules enable awake"
msgstr "Így kapcsolhatja be: tuxtoys modules enable awake"

#: tuxtoys/cli.py tuxtoys/settings/awake_page.py
#: tuxtoys/settings/overview_page.py tuxtoys/tray/app.py
#, python-brace-format
msgid "TuxToys refused: {reason}"
msgstr "A TuxToys nem teljesítette a kérést: {reason}"

#. TRANSLATORS: a module's state in the list `tuxtoys modules` prints.
#: tuxtoys/cli.py
msgid "on"
msgstr "bekapcsolva"

#. TRANSLATORS: a module's state in the list `tuxtoys modules` prints.
#: tuxtoys/cli.py
msgid "off"
msgstr "kikapcsolva"

#. TRANSLATORS: a module's state in the list `tuxtoys modules` prints.
#: tuxtoys/cli.py
msgid "failed"
msgstr "hibás"

#: tuxtoys/cli.py
msgid "Power-user utilities for Linux Mint Cinnamon."
msgstr "Segédeszközök haladó felhasználóknak, Linux Mint Cinnamonhoz."

#: tuxtoys/cli.py
msgid "COMMAND"
msgstr "PARANCS"

#: tuxtoys/cli.py
msgid "keep the computer awake"
msgstr "a számítógép ébren tartása"

#: tuxtoys/cli.py
msgid "Keep the computer awake."
msgstr "A számítógép ébren tartása."

#: tuxtoys/cli.py
msgid "ACTION"
msgstr "MŰVELET"

#: tuxtoys/cli.py
msgid "switch Awake on"
msgstr "az Awake bekapcsolása"

#: tuxtoys/cli.py
msgid ""
"Switch Awake on: until you turn it off, for a set time, or until a time of "
"day."
msgstr ""
"Az Awake bekapcsolása: amíg ki nem kapcsolja, adott ideig vagy egy adott "
"időpontig."

#: tuxtoys/cli.py
msgid "DURATION"
msgstr "IDŐTARTAM"

#: tuxtoys/cli.py
msgid "stay awake this long: 90 or 90m, 2h, 1h30m"
msgstr "ébren tartás ennyi ideig: 90 vagy 90m, 2h, 1h30m"

#: tuxtoys/cli.py
msgid "HH:MM"
msgstr "ÓÓ:PP"

#: tuxtoys/cli.py
msgid "stay awake until this time of day, even one past midnight"
msgstr "ébren tartás eddig az időpontig, akár éjfél után is"

#: tuxtoys/cli.py
msgid "keep the screen on as well, or not; without either, as set in TuxToys"
msgstr ""
"a képernyő is maradjon bekapcsolva, vagy ne; ha egyik sincs megadva, a "
"TuxToys beállítása szerint"

#: tuxtoys/cli.py
msgid "switch Awake off"
msgstr "az Awake kikapcsolása"

#: tuxtoys/cli.py
msgid "switch Awake off when on, or on as set in TuxToys; good for a shortcut"
msgstr ""
"az Awake kikapcsolása, ha be van kapcsolva, különben bekapcsolása a TuxToys "
"beállítása szerint; gyorsbillentyűhöz ideális"

#: tuxtoys/cli.py
msgid "show whether Awake is on, and for how long"
msgstr "megmutatja, be van-e kapcsolva az Awake, és meddig"

#: tuxtoys/cli.py
msgid "list the modules, switch one on or off"
msgstr "a modulok listázása, egy modul be- vagy kikapcsolása"

#: tuxtoys/cli.py
msgid "List TuxToys' modules, or switch one on or off."
msgstr ""
"A TuxToys moduljainak listázása, vagy egy modul be- vagy kikapcsolása."

#: tuxtoys/cli.py
msgid "list the modules and their state (the default)"
msgstr "a modulok és állapotuk listázása (alapértelmezés)"

#: tuxtoys/cli.py
msgid "switch a module on"
msgstr "egy modul bekapcsolása"

#: tuxtoys/cli.py
msgid "switch a module off"
msgstr "egy modul kikapcsolása"

#: tuxtoys/cli.py
msgid "MODULE"
msgstr "MODUL"

#: tuxtoys/cli.py
#, python-brace-format
msgid ""
"'{text}' is not a duration. Use minutes (90 or 90m), hours (2h), or both "
"(1h30m)."
msgstr ""
"„{text}” nem időtartam. Adja meg percben (90 vagy 90m), órában (2h) vagy "
"órában és percben (1h30m)."

#: tuxtoys/cli.py
#, python-brace-format
msgid "'{text}' is not a time of day. Use hours and minutes, such as 18:00."
msgstr "„{text}” nem időpont. Adja meg óra:perc alakban, például 18:00."

#: tuxtoys/modules/awake/module.py tuxtoys/settings/awake_page.py
msgid "Awake"
msgstr "Awake"

#: tuxtoys/modules/awake/module.py
msgid ""
"Keeps the computer awake until you turn it off, for a set time, or until a "
"time of day, without changing your power settings."
msgstr ""
"Ébren tartja a számítógépet, amíg ki nem kapcsolja, adott ideig vagy egy "
"adott időpontig, az energiagazdálkodási beállítások módosítása nélkül."

#: tuxtoys/modules/awake/module.py
msgid "Awake is keeping the computer awake"
msgstr "Az Awake ébren tartja a számítógépet"

#: tuxtoys/modules/awake/module.py
msgid "Awake is off"
msgstr "Az Awake kikapcsolt"

#: tuxtoys/modules/awake/module.py
msgid "The time is up. Your usual power settings apply again."
msgstr ""
"Letelt az idő. Ismét a megszokott energiagazdálkodási beállítások érvényesek."

#: tuxtoys/modules/awake/text.py
msgid "Awake is off."
msgstr "Az Awake ki van kapcsolva."

#: tuxtoys/modules/awake/text.py
msgid "Awake is on until you turn it off."
msgstr "Az Awake bekapcsolva marad, amíg ki nem kapcsolja."

#. TRANSLATORS: {left} is the time left, such as "1 h 25 min", and {end} the time Awake
#. ends, such as "18:00", with the date in front when that is more than a day away.
#: tuxtoys/modules/awake/text.py
#, python-brace-format
msgid "Awake is on for {left} more, until {end}."
msgstr "Az Awake {end}-ig marad bekapcsolva, még {left} van hátra."

#: tuxtoys/modules/awake/text.py
msgid "The screen stays on."
msgstr "A képernyő bekapcsolva marad."

#: tuxtoys/modules/awake/text.py
msgid "The screen may turn off, but the computer will not sleep."
msgstr "A képernyő kikapcsolhat, de a számítógép nem megy alvó állapotba."

#: tuxtoys/modules/awake/text.py
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} perc"

#: tuxtoys/modules/awake/text.py
#, python-brace-format
msgid "{hours} h"
msgstr "{hours} óra"

#: tuxtoys/modules/awake/text.py
#, python-brace-format
msgid "{hours} h {minutes} min"
msgstr "{hours} óra {minutes} perc"

#. TRANSLATORS: the units after the hours field and after the minutes field.
#: tuxtoys/settings/awake_page.py tuxtoys/tray/app.py
msgid "h"
msgstr "óra"

#. TRANSLATORS: the units after the hours field and after the minutes field.
#: tuxtoys/settings/awake_page.py tuxtoys/tray/app.py
msgid "min"
msgstr "perc"

#: tuxtoys/settings/awake_page.py
msgid "Keeps the computer awake, without changing your power settings."
msgstr ""
"Ébren tartja a számítógépet, az energiagazdálkodási beállítások módosítása "
"nélkül."

#: tuxtoys/settings/awake_page.py
msgid "Use Awake"
msgstr "Awake használata"

#: tuxtoys/settings/awake_page.py
msgid "When you click the panel icon"
msgstr "A panelikonra kattintáskor"

#: tuxtoys/settings/awake_page.py
msgid ""
"The same goes for tuxtoys awake toggle, on a keyboard shortcut or in a "
"script."
msgstr ""
"Ugyanez érvényes a tuxtoys awake toggle parancsra is, gyorsbillentyűn vagy "
"szkriptben."

#: tuxtoys/settings/awake_page.py
msgid "Keep the computer awake"
msgstr "Számítógép ébren tartása"

#. TRANSLATORS: the label in front of the hours and minutes of a duration.
#: tuxtoys/settings/awake_page.py
msgid "For"
msgstr "Időtartam"

#. TRANSLATORS: the label in front of a time of day.
#: tuxtoys/settings/awake_page.py
msgid "Until"
msgstr "Időpont"

#: tuxtoys/settings/awake_page.py tuxtoys/tray/app.py
msgid "Keep the screen on"
msgstr "Képernyő bekapcsolva tartása"

#: tuxtoys/settings/awake_page.py
msgid "Otherwise the screen may turn off, but the computer will not sleep."
msgstr ""
"Különben a képernyő kikapcsolhat, de a számítógép nem megy alvó állapotba."

#: tuxtoys/settings/awake_page.py
msgid "Keyboard shortcut"
msgstr "Gyorsbillentyű"

#: tuxtoys/settings/awake_page.py
msgid "Add a custom shortcut in the Keyboard settings with this command."
msgstr ""
"Ezzel a paranccsal vegyen fel egyéni gyorsbillentyűt a "
"billentyűzet-beállításokban."

#: tuxtoys/settings/awake_page.py
msgid "Command"
msgstr "Parancs"

#: tuxtoys/settings/awake_page.py
msgid "Open the Keyboard settings"
msgstr "Billentyűzet-beállítások megnyitása"

#: tuxtoys/settings/awake_page.py
msgid "This version of TuxToys has no Awake."
msgstr "A TuxToys ezen verziójában nincs Awake."

#: tuxtoys/settings/awake_page.py tuxtoys/tray/app.py
msgid "TuxToys is not running."
msgstr "A TuxToys nem fut."

#: tuxtoys/settings/awake_page.py
#, python-brace-format
msgid "Could not read Awake's settings: {error}"
msgstr "Az Awake beállításai nem olvashatók be: {error}"

#: tuxtoys/settings/awake_page.py
#, python-brace-format
msgid "Awake could not be switched on: {error}"
msgstr "Az Awake bekapcsolása nem sikerült: {error}"

#. TRANSLATORS: a heading in the settings window's sidebar, over the tools that
#. deal with the computer as a whole, such as Awake.
#: tuxtoys/settings/catalog.py
msgid "System"
msgstr "Rendszer"

#: tuxtoys/settings/main.py
#, python-brace-format
msgid "The settings need PyGObject, GTK 3 and python3-xapp: {error}"
msgstr "A beállításokhoz PyGObject, GTK 3 és python3-xapp szükséges: {error}"

#: tuxtoys/settings/main.py tuxtoys/settings/window.py
#: data/applications/io.github.konabe_studio.TuxToys.desktop.in
#: data/autostart/io.github.konabe_studio.TuxToys.desktop.in
msgid "TuxToys"
msgstr "TuxToys"

#. TRANSLATORS: under a tool's description in the Overview, when it failed.
#: tuxtoys/settings/overview_page.py
#, python-brace-format
msgid "Could not be switched on: {error}"
msgstr "Nem sikerült bekapcsolni: {error}"

#: tuxtoys/settings/overview_page.py
msgid ""
"Welcome to TuxToys. Switch on the tools you want to use. Each one has a "
"page of its own in the sidebar."
msgstr ""
"Üdvözli a TuxToys. Kapcsolja be azokat az eszközöket, amelyeket használni "
"szeretne. Mindegyiknek saját oldala van az oldalsávon."

#: tuxtoys/settings/overview_page.py
msgid "Tools"
msgstr "Eszközök"

#: tuxtoys/settings/values.py tuxtoys/tray/app.py
msgid "Until turned off"
msgstr "Kikapcsolásig"

#: tuxtoys/settings/values.py
msgid "For a set time"
msgstr "Adott ideig"

#: tuxtoys/settings/values.py
msgid "Until a time of day"
msgstr "Egy adott időpontig"

#. TRANSLATORS: the first page of the settings window, listing every tool.
#: tuxtoys/settings/window.py
msgid "Overview"
msgstr "Áttekintés"

#: tuxtoys/tray/app.py
msgid "For a custom time…"
msgstr "Egyéni időtartamra…"

#: tuxtoys/tray/app.py
msgid "Until a time of day…"
msgstr "Egy adott időpontig…"

#: tuxtoys/tray/app.py
msgid "Turn off"
msgstr "Kikapcsolás"

#: tuxtoys/tray/app.py
msgid "Settings…"
msgstr "Beállítások…"

#: tuxtoys/tray/app.py
msgid "Keep the computer awake for"
msgstr "Számítógép ébren tartása ennyi ideig"

#: tuxtoys/tray/app.py
msgid "Keep the computer awake until"
msgstr "Számítógép ébren tartása eddig"

#: tuxtoys/tray/app.py
msgid "Cancel"
msgstr "Mégse"

#: tuxtoys/tray/app.py
msgid "Start"
msgstr "Indítás"

#: tuxtoys/tray/main.py
#, python-brace-format
msgid "The panel icon needs PyGObject, GTK 3 and XApp: {error}"
msgstr "A panelikonhoz PyGObject, GTK 3 és XApp szükséges: {error}"

#: tuxtoys/tray/main.py
msgid "The panel icon needs a desktop session."
msgstr "A panelikonhoz asztali munkamenet szükséges."

#: tuxtoys/tray/main.py
msgid "The TuxToys panel icon is already running."
msgstr "A TuxToys panelikonja már fut."

#. TRANSLATORS: items of the panel icon's menu, each keeping the computer awake for
#. that long.
#: tuxtoys/tray/view.py
#, python-brace-format
msgid "For {count} minute"
msgid_plural "For {count} minutes"
msgstr[0] "{count} percre"
msgstr[1] "{count} percre"

#: tuxtoys/tray/view.py
#, python-brace-format
msgid "For {count} hour"
msgid_plural "For {count} hours"
